function openTopic(i){let t=D.topics[i];document.getElementById('detail').innerHTML=`<button class="alt" onclick="page('materi')">← Kembali</button><h2>${t.title}</h2><div class="lesson"><p>${t.summary}</p><h3>Penjelasan singkat</h3><p>${t.detail}</p><h3>Ingat!</h3><p>Pahami konsep, cari contoh dalam kehidupan sehari-hari, dan diskusikan dengan teman atau guru.</p></div><div class="video"><b>Video pembelajaran dari playlist</b><p>Jika pemutar tidak menampilkan video, gunakan tautan playlist.</p><iframe src="https://www.youtube-nocookie.com/embed/videoseries?list=PLHF1lx_r6PF0" allowfullscreen title="Playlist Informatika"></iframe><a style="color:white" target="_blank" href="${playlist}">Buka playlist YouTube ↗</a></div><p><button onclick="document.getElementById('pilih').value=${i};renderQs();page('latihan')">Kerjakan latihan bab ini</button></p>`;page('detail')}
function renderQs(){let i=Number(document.getElementById('pilih').value||0),arr=D.questions[i];document.getElementById('qs').innerHTML=arr.map((q,n)=>`<div class="q"><b>${n+1}. ${q[0]}</b>${q[1].map((o,j)=>`<label class="opt"><input type="radio" name="q${n}" value="${j}"> ${String.fromCharCode(65+j)}. ${o}</label>`).join('')}<div id="f${n}" class="feedback hidden"></div></div>`).join('')+`<button onclick="grade(${i})">Periksa jawaban</button> <button class="alt" onclick="renderQs()">Ulangi</button><div id="scorebox"></div>`}
function grade(i){if(!student){alert('Isi nama dan kelas dahulu.');return}let arr=D.questions[i],score=0;arr.forEach((q,n)=>{let a=document.querySelector('input[name="q'+n+'"]:checked'),f=document.getElementById('f'+n);f.classList.remove('hidden');if(a&&Number(a.value)===q[2]){score++;f.textContent='Benar. '+q[3];f.style.background='#e8f7ef'}else{f.textContent='Jawaban benar: '+q[1][q[2]]+'. '+q[3];f.style.background='#fff1f0'}});let r={title:D.topics[i].title,score:Math.round(score/arr.length*100),correct:score,total:arr.length,date:new Date().toLocaleString('id-ID')};let rs=JSON.parse(localStorage.getItem('ifxResults')||'[]');rs.unshift(r);localStorage.setItem('ifxResults',JSON.stringify(rs.slice(0,50)));document.getElementById('scorebox').innerHTML=`<div class="feedback"><div class="score">${r.score}</div><b>${student.n} • ${student.c}</b><p>${score} dari ${arr.length} jawaban benar. Pembahasan tersedia pada setiap soal.</p></div>`}
function showResults(){let rs=JSON.parse(localStorage.getItem('ifxResults')||'[]');document.getElementById('results').innerHTML=rs.length?`<p class="muted">${student?student.n+' • '+student.c:'Identitas belum diisi'}</p>`+rs.map(r=>`<div class="q"><b>${r.title}</b><div class="score">${r.score}</div><small class="muted">${r.correct}/${r.total} benar • ${r.date}</small></div>`).join(''):'<p class="muted">Belum ada nilai. Kerjakan latihan untuk melihat hasilnya.</p>'}
const pairs=[['CPU','Memproses instruksi dan data'],['RAM','Menyimpan data sementara'],['Router','Menghubungkan jaringan yang berbeda'],['DNS','Menerjemahkan nama domain ke alamat IP'],['Algoritma','Langkah logis untuk menyelesaikan masalah'],['Spreadsheet','Mengolah data dalam tabel']];
let shuffled=[...pairs].sort(()=>Math.random()-.5);
function matchInit(){document.getElementById('matching').innerHTML=pairs.map((p,i)=>`<div class="q"><b>${i+1}. ${p[1]}</b><select id="m${i}"><option value="">Pilih istilah</option>${shuffled.map(s=>`<option>${s[0]}</option>`).join('')}</select></div>`).join('')}
function checkMatch(){let n=0;pairs.forEach((p,i)=>{if(document.getElementById('m'+i).value===p[0])n++});document.getElementById('matchresult').innerHTML=`<div class="feedback"><b>Skor: ${n}/${pairs.length}</b></div>`}
document.getElementById('homecards').innerHTML=D.topics.map(card).join('');document.getElementById('matcards').innerHTML=D.topics.map(card).join('');document.getElementById('pilih').innerHTML=D.topics.map((t,i)=>`<option value="${i}">${t.title}</option>`).join('');if(student){nama.value=student.n;kelas.value=student.c;status.textContent='Halo, '+student.n}renderQs();matchInit();
</script></body></html>
